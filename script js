const PASSECODE_CORRECT = "1010";
let pinEntered = "";

// Ambil DOM Element
const lockScreen = document.getElementById('lockScreen');
const passcodeScreen = document.getElementById('passcodeScreen');
const homeScreen = document.getElementById('homeScreen');
const dots = document.querySelectorAll('.dot');

// 1. MEKANISME REAL-TIME CLOCK (WAKTU ASLI)
function runClock() {
    const timeNow = new Date();
    
    let hours = String(timeNow.getHours()).padStart(2, '0');
    let minutes = String(timeNow.getMinutes()).padStart(2, '0');
    document.getElementById('iosClock').innerText = `${hours}:${minutes}`;

    const days = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
    const months = ["Oktober", "November", "Desember", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September"];
    
    // Penyesuaian agar teks hari sesuai penanggalan lokal
    let currentDayStr = days[timeNow.getDay()];
    let currentDateNum = timeNow.getDate();
    let currentMonthStr = months[timeNow.getMonth()];

    document.getElementById('iosDate').innerText = `${currentDayStr}, ${currentDateNum} ${currentMonthStr}`;
}
runClock();
setInterval(runClock, 1000);

// 2. KONTROL PERPINDAHAN HALAMAN
function showPasscode() {
    passcodeScreen.classList.add('show');
}

function cancelPasscode() {
    passcodeScreen.classList.remove('show');
    resetPinState();
}

// 3. LOGIKA MASUKKAN SANDI 1010
function pressNum(digit) {
    if (pinEntered.length < 4) {
        pinEntered += digit;
        refreshDots();

        if (pinEntered.length === 4) {
            setTimeout(validatePin, 250);
        }
    }
}

function refreshDots() {
    dots.forEach((dot, idx) => {
        if (idx < pinEntered.length) {
            dot.classList.add('active');
        } else {
            dot.classList.remove('active');
        }
    });
}

function deleteNum() {
    pinEntered = pinEntered.slice(0, -1);
    refreshDots();
}

function resetPinState() {
    pinEntered = "";
    refreshDots();
}

function validatePin() {
    if (pinEntered === PASSECODE_CORRECT) {
        // Efek transisi sukses membuka HP
        passcodeScreen.classList.remove('show');
        lockScreen.classList.add('hide');
        homeScreen.classList.add('active');
    } else {
        alert("Sandi Salah! Petunjuk: Ulang Tahun Yan.");
        resetPinState();
    }
}
